{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "FocusList: Lint + Test",
      "type": "shell",
      "command": "uv run ruff check --output-format=concise . && uv run pytest",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": {
        "owner": "ruff",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): (\\S+) (.*)$",
          "file": 1, "line": 2, "column": 3, "code": 4, "message": 5
        }
      }
    }
  ]
}
